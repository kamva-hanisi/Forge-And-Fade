SESSION_ENCRYPT=true
QUEUE_CONNECTION=database

BOOKING_REQUESTS_PER_MINUTE=15
BOOKING_REQUESTS_PER_HOUR=30
CONTACT_REQUESTS_PER_MINUTE=5
CONTACT_REQUESTS_PER_HOUR=20
